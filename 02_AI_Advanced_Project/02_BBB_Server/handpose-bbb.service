[Unit]
Description=MobileHandPose ONNX TCP server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=debian
Group=debian
WorkingDirectory=/home/debian/handpose
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/usr/bin/test -s /home/debian/handpose/handpose_accuracy_epoch84_opset11.onnx
ExecStart=/usr/bin/python3 /home/debian/handpose/bbb_pose_server.py --model /home/debian/handpose/handpose_accuracy_epoch84_opset11.onnx --host 0.0.0.0 --port 5000 --threads 1 --jpeg-quality 82 --image-size 128 --heatmap-size 64
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
